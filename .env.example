# Copy this file to .env for local testing only (never commit the real .env).
# In production, set GEMINI_API_KEY as an environment variable in the Vercel
# dashboard instead — never paste the real key into a file that gets committed.

GEMINI_API_KEY=your_free_gemini_api_key_here

# Optional: override the model (defaults to gemini-2.0-flash if unset).
# GEMINI_MODEL=gemini-2.0-flash
